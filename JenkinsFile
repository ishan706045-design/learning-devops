pipeline {
    agent any

    environment {
        PROJECT_ID = "synthetic-diode-478517-e0"
        REGION = "asia-south1"
        REPO = "krishna"
        IMAGE = "myapp"
        TAG = "${env.GIT_COMMIT.take(7)}"
        IMAGE_URL = "${env.REGION}-docker.pkg.dev/${env.PROJECT_ID}/${env.REPO}/${env.IMAGE}:${env.TAG}"
        K8S_NAMESPACE = "learning"
    }

    stages {

        stage('Checkout Code') {
            steps {
                echo "Checking out code..."
            }
        }

        stage('Build Docker Image') {
            steps {
                sh """
                echo "Building image: ${IMAGE_URL}"
                docker build -t ${IMAGE_URL} .
                """
            }
        }

        stage('Login to Google Artifact Registry') {
            steps {
                withCredentials([file(credentialsId: 'gcp-json', variable: 'GCP_KEY')]) {
                    sh """
                    cat $GCP_KEY | docker login -u _json_key --password-stdin https://${REGION}-docker.pkg.dev
                    """
                }
            }
        }

        stage('Push Image') {
            steps {
                sh "docker push ${IMAGE_URL}"
            }
        }

        stage('Deploy using Helm') {
            steps {
                sh '''
                helm upgrade --install myapp ./charts \
                  --namespace learning \
                  --create-namespace \
                  --set image.repository=asia-south1-docker.pkg.dev/synthetic-diode-478517-e0/krishna/myapp \
                  --set image.tag=${TAG}
                '''
            }
        }
    }

    // ✅ EMAIL NOTIFICATION BLOCK (MAILTRAP)
    post {
        success {
            emailext(
                subject: "✅ SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                <h2 style="color:green;">Build Successful</h2>
                <b>Project:</b> ${env.JOB_NAME}<br>
                <b>Build Number:</b> ${env.BUILD_NUMBER}<br>
                <b>Image:</b> ${IMAGE_URL}<br>
                <b>Namespace:</b> ${K8S_NAMESPACE}<br>
                <b>Status:</b> SUCCESS<br><br>
                🔗 <a href="${env.BUILD_URL}">View Build</a>
                """,
                to: "demo@company.com"
            )
        }

        failure {
            emailext(
                subject: "❌ FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                <h2 style="color:red;">Build Failed</h2>
                <b>Project:</b> ${env.JOB_NAME}<br>
                <b>Build Number:</b> ${env.BUILD_NUMBER}<br>
                <b>Image:</b> ${IMAGE_URL}<br>
                <b>Namespace:</b> ${K8S_NAMESPACE}<br>
                <b>Status:</b> FAILED<br><br>
                🔗 <a href="${env.BUILD_URL}">View Build Logs</a>
                """,
                to: "demo@company.com"
            )
        }
    }
}
